{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "ci": "npm run lint && npm run typecheck && npm run build",
    "preview": "vite preview",
    "deploy": "npx vercel --prod",
    "docker:build": "docker build -t ntphong04102k4/portfolio-mobile:latest .",
    "docker:run": "docker run -d --name portfolio-mobile -p 3000:80 ntphong04102k4/portfolio-mobile:latest",
    "docker:stop": "docker stop portfolio-mobile && docker rm portfolio-mobile",
    "docker:up": "docker compose up -d portfolio",
    "docker:up:dev": "docker compose up portfolio-dev",
    "docker:down": "docker compose down",
    "clean": "npx rimraf dist node_modules"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "framer-motion": "^12.34.5",
    "lucide-react": "^1.31.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
